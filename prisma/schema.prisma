generator client {
 provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  emailVerified DateTime?
  image     String?

  password  String?
  role      Role     @default(USER)

  xp                       Int     @default(0)
  level                    Int     @default(1)
  showOnLeaderboard        Boolean @default(true)
  receivePromotionalEmails Boolean @default(true)

  // Company membership (for MODERATOR role)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  accounts  Account[]
  sessions  Session[]

  transactions      Transaction[]
  xpLogs            XpTransaction[]
  badges            UserBadge[]
  reviews           Review[]
  reviewRequests    ReviewRequest[]
  createdEvents     Event[]         @relation("CreatedEvents")
  receivedPenalties Penalty[]       @relation("ReceivedPenalties")
  issuedPenalties   Penalty[]       @relation("IssuedPenalties")

  PasswordResets PasswordReset[]

  createdAt DateTime @default(now())

  @@index([role])
  @@index([createdAt])
  @@index([companyId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id            String     @id @default(cuid())
  name          String
  brand         String
  model         String     @default("Unknown")
  year          Int        @default(2020)
  category      String     @default("Sedan")
  description   String
  pricePerDay   Float
  deposit       Float?
  transmission  String     @default("Automatic")
  fuelType      String     @default("Petrol")
  seats         Int        @default(4)
  horsepower    Int?
  drivetrain    String?
  zeroToHundred Float?
  topSpeed      Int?
  mileage       Int        @default(0)
  licensePlate  String     @default("UNKNOWN")
  location      String     @default("Budapest")
  minimumAge    Int?
  minimumRentalDays Int?
  dailyKmLimit  Int?
  excessKmFee   Float?
  featured      Boolean    @default(false)
  active        Boolean    @default(false)
  rating        Float?
  reviewCount   Int?

  // Company ownership
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Approval workflow
  approvalStatus ApprovalStatus @default(PENDING)
  adminNote      String?        @db.Text

  images          CarImage[]
  transactions    Transaction[]
  reviews         Review[]
  reviewRequests  ReviewRequest[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([active])
  @@index([category])
  @@index([location])
  @@index([featured, active])
  @@index([active, pricePerDay])
  @@index([companyId])
  @@index([approvalStatus])
}

model CarImage {
  id        String  @id @default(cuid())
  url       String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  // Rental period
  startDate DateTime
  endDate   DateTime
  totalDays Int

  // Pricing snapshot
  pricePerDay     Float
  totalPrice      Float
  deposit         Float?
  discountApplied Float?  // percentage discount applied at booking (e.g. 0.10 = 10%)

  // Gamification
  xpAwarded Int?    // XP awarded when booking was completed

  // Rental lifecycle
  status TransactionStatus @default(PENDING)

  // Optional payment integration
  stripeSessionId String?
  paymentIntentId String?

  // Mileage tracking
  startMileage      Int?   // odometer at pickup
  endMileage        Int?   // odometer at return
  extraKmPurchased        Int     @default(0)
  excessKmCharge          Float?
  excessKmStripeSessionId String? @unique
  excessKmStripeUrl       String?
  excessKmPaid            Boolean @default(false)

  // Vehicle inspection at return
  inspectionReport        Json?
  damageCharge            Float?
  damageStripeSessionId   String? @unique
  damageStripeUrl         String?
  damagePaid              Boolean @default(false)

  // Km package purchase history
  kmPurchases       KmPurchase[]
  reviewRequests    ReviewRequest[]
  xpLogs            XpTransaction[]

  // Event discount (applied at booking creation)
  eventDiscountApplied Float?
  xpMultiplier         Float  @default(1)

  // Admin notes
  notes String?

  @@index([userId, status])
  @@index([productId, status])
  @@index([status, createdAt])
  @@index([startDate, endDate])
  @@index([stripeSessionId])
  @@index([paymentIntentId])
}
enum TransactionStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

model KmPurchase {
  id              String      @id @default(cuid())
  kmAmount        Int
  pricePaid       Float
  stripeSessionId String?     @unique
  createdAt       DateTime    @default(now())

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([stripeSessionId])
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String      @default("🏆")

  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model XpTransaction {
 id            String @id @default(cuid())

 user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
 userId        String

 transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
 transactionId String?

 xpAmount      Int

 createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?  @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([approved])
}

model ReviewRequest {
  id            String    @id @default(cuid())
  token         String    @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model NewsletterLog {
  id            String   @id @default(cuid())
  subject       String
  body          String   @db.Text
  sentCount     Int
  failedCount   Int
  filters       String?  @db.Text  // JSON snapshot of filters used
  sentBy        String            // admin userId
  createdAt     DateTime @default(now())
}

enum Role {
  ADMIN
  USER
  MODERATOR
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  level     LogLevel @default(INFO)
  action    String   // e.g. "booking.created", "car.approved", "user.role_changed"
  entity    String?  // "booking" | "car" | "user" | "review" | "payment"
  entityId  String?  // ID of the affected record

  userId    String?  // actor (null = system/webhook)
  userEmail String?  // snapshot at time of action
  userRole  String?  // snapshot

  metadata  Json?    // extra structured details (amounts, old→new status, etc.)

  @@index([createdAt])
  @@index([action])
  @@index([entity, entityId])
  @@index([userId])
}

model Company {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?       @db.Text
  logoUrl     String?
  website     String?
  address     String?
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users     User[]
  products  Product[]
  events    Event[]
  penalties Penalty[]

  @@index([slug])
  @@index([status])
}

enum EventEffectType {
  DISCOUNT_PCT
  XP_MULTIPLIER
  EXTRA_KM_PER_DAY
  FREE_DAYS
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Event {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  bannerUrl   String?

  startsAt    DateTime
  endsAt      DateTime

  effectType  EventEffectType
  effectValue Float

  targetCategories String[]
  targetBrands     String[]
  minDays          Int?

  status    EventStatus @default(DRAFT)
  adminNote String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CreatedEvents", fields: [createdById], references: [id], onDelete: Cascade)

  notificationSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startsAt, endsAt])
  @@index([companyId])
  @@index([createdById])
}

enum PenaltyStatus {
  UNPAID
  PAID
  CANCELLED
}

model Penalty {
  id               String        @id @default(cuid())

  userId           String
  user             User          @relation("ReceivedPenalties", fields: [userId], references: [id], onDelete: Cascade)

  issuedById       String
  issuedBy         User          @relation("IssuedPenalties", fields: [issuedById], references: [id], onDelete: Cascade)

  companyId        String?
  company          Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)

  reason           String        @db.Text
  amount           Float

  status           PenaltyStatus @default(UNPAID)

  stripeSessionId  String?       @unique
  stripePaymentUrl String?
  paidAt           DateTime?

  notificationSent Boolean       @default(false)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([issuedById])
  @@index([companyId])
  @@index([status])
}