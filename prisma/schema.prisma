generator client {
 provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  emailVerified DateTime?
  image     String?

  password  String?
  role      Role     @default(USER)

  xp                       Int     @default(0)
  level                    Int     @default(1)
  showOnLeaderboard        Boolean @default(true)
  receivePromotionalEmails Boolean @default(true)

  accounts  Account[]
  sessions  Session[]

  transactions Transaction[]
  xpLogs      XpTransaction[]
  badges      UserBadge[]
  reviews     Review[]

  PasswordResets PasswordReset[]

  createdAt DateTime @default(now())

  @@index([role])
  @@index([createdAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id            String     @id @default(cuid())
  name          String
  brand         String
  model         String     @default("Unknown")
  year          Int        @default(2020)
  category      String     @default("Sedan")
  description   String
  pricePerDay   Float
  deposit       Float?     // opcionális
  transmission  String     @default("Automatic")
  fuelType      String     @default("Petrol")
  seats         Int        @default(4)
  horsepower    Int?       // opcionális
  drivetrain    String?    // opcionális
  zeroToHundred Float?     // opcionális
  topSpeed      Int?       // opcionális
  mileage       Int        @default(0)
  licensePlate  String     @default("UNKNOWN")
  location      String     @default("Budapest")
  minimumAge    Int?       // opcionális
  minimumRentalDays Int?   // opcionális
  dailyKmLimit  Int?       // included km per day, null = unlimited
  excessKmFee   Float?     // €/km over limit, null = no excess charge
  featured      Boolean    @default(false)
  active        Boolean    @default(true)
  rating        Float?     // opcionális
  reviewCount   Int?       // opcionális

  images        CarImage[]
  transactions  Transaction[]
  reviews       Review[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([active])
  @@index([category])
  @@index([location])
  @@index([featured, active])
  @@index([active, pricePerDay])
}

model CarImage {
  id        String  @id @default(cuid())
  url       String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  // Rental period
  startDate DateTime
  endDate   DateTime
  totalDays Int

  // Pricing snapshot
  pricePerDay     Float
  totalPrice      Float
  deposit         Float?
  discountApplied Float?  // percentage discount applied at booking (e.g. 0.10 = 10%)

  // Gamification
  xpAwarded Int?    // XP awarded when booking was completed

  // Rental lifecycle
  status TransactionStatus @default(PENDING)

  // Optional payment integration
  stripeSessionId String?
  paymentIntentId String?

  // Mileage tracking
  startMileage      Int?   // odometer at pickup
  endMileage        Int?   // odometer at return
  extraKmPurchased  Int    @default(0) // total extra km bought (sum of all packages)
  excessKmCharge    Float? // computed: (usedKm − allowedKm − extraKmPurchased) × excessKmFee

  // Km package purchase history
  kmPurchases       KmPurchase[]

  // Admin notes
  notes String?

  @@index([userId, status])
  @@index([productId, status])
  @@index([status, createdAt])
  @@index([startDate, endDate])
  @@index([stripeSessionId])
  @@index([paymentIntentId])
}
enum TransactionStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

model KmPurchase {
  id              String      @id @default(cuid())
  kmAmount        Int
  pricePaid       Float
  stripeSessionId String?     @unique
  createdAt       DateTime    @default(now())

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([stripeSessionId])
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String      @default("🏆")

  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model XpTransaction {
 id            String @id @default(cuid())

 user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
 userId        String

 transactionId String?

 xpAmount      Int

 createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?  @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([approved])
}

model NewsletterLog {
  id            String   @id @default(cuid())
  subject       String
  body          String   @db.Text
  sentCount     Int
  failedCount   Int
  filters       String?  @db.Text  // JSON snapshot of filters used
  sentBy        String            // admin userId
  createdAt     DateTime @default(now())
}

enum Role {
 ADMIN
 USER
 MODERATOR
}