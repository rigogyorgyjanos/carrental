generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
 url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  emailVerified DateTime?
  image     String? 

  password  String?
  role      Role     @default(USER)

  xp        Int      @default(0)
  level     Int      @default(1)

  accounts  Account[]
  sessions  Session[]

  transactions Transaction[]
  xpLogs      XpTransaction[]

  PasswordResets PasswordReset[] 
  
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id            String     @id @default(cuid())
  name          String
  brand         String
  model         String     @default("Unknown")
  year          Int        @default(2020)
  category      String     @default("Sedan")
  description   String
  pricePerDay   Float
  deposit       Float?     // opcionális
  transmission  String     @default("Automatic")
  fuelType      String     @default("Petrol")
  seats         Int        @default(4)
  horsepower    Int?       // opcionális
  drivetrain    String?    // opcionális
  zeroToHundred Float?     // opcionális
  topSpeed      Int?       // opcionális
  mileage       Int        @default(0)
  licensePlate  String     @default("UNKNOWN")
  location      String     @default("Budapest")
  minimumAge    Int?       // opcionális
  minimumRentalDays Int?   // opcionális
  featured      Boolean    @default(false)
  active        Boolean    @default(true)
  rating        Float?     // opcionális
  reviewCount   Int?       // opcionális

  images        CarImage[]
  transactions  Transaction[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt 
}

model CarImage {
  id        String  @id @default(cuid())
  url       String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User    @relation(fields: [userId], references: [id])
  userId    String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  // Rental period
  startDate DateTime
  endDate   DateTime
  totalDays Int

  // Pricing snapshot
  pricePerDay Float
  totalPrice  Float
  deposit     Float?

  // Rental lifecycle
  status TransactionStatus @default(PENDING)

  // Optional payment integration
  paymentIntentId String?

  // Admin notes
  notes String?
}
enum TransactionStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Badge {
 id          String @id @default(cuid())
 name        String
 description String
}

model XpTransaction {
 id            String @id @default(cuid())

 user          User   @relation(fields: [userId], references: [id])
 userId        String

 transactionId String?

 xpAmount      Int

 createdAt DateTime @default(now())
}

enum Role {
 ADMIN
 USER
 MODERATOR
}